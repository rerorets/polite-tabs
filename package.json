{
  "name": "polite-tabs",
  "version": "7.0.0",
  "private": true,
  "description": "URL やページのタイトルで、タブを自動でグループにまとめます。ほかの拡張が作ったグループには触りません。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/rerorets/polite-tabs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "icons": "node scripts/render-icons.mjs",
    "package": "npm run build && cd build && zip -qr ../polite-tabs.zip . && cd .. && echo polite-tabs.zip",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "emoji-mart": "^5.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
